@model IEnumerable<PhotographyPortfolio.Models.Video>

@{
    ViewData["Title"] = "Video Management";
}

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">

<style>
    body {
        font-family: 'Poppins', sans-serif;
        background: linear-gradient(135deg, #0f172a, #020617);
        color: #fff;
    }

    .admin-container {
        padding: 30px;
    }

    .admin-header {
        background: rgba(255,255,255,0.05);
        backdrop-filter: blur(12px);
        border-radius: 15px;
        padding: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
        box-shadow: 0 8px 30px rgba(0,0,0,0.5);
    }

        .admin-header h3 {
            font-weight: 600;
            margin: 0;
        }

    .btn-custom {
        border-radius: 30px;
        padding: 6px 16px;
        font-size: 14px;
        transition: 0.3s ease;
    }

    .btn-success {
        background: linear-gradient(45deg, #22c55e, #16a34a);
        border: none;
    }

    .btn-primary {
        background: linear-gradient(45deg, #3b82f6, #2563eb);
        border: none;
    }

    .btn-danger {
        background: linear-gradient(45deg, #ef4444, #dc2626);
        border: none;
    }

    .btn-secondary {
        background: linear-gradient(45deg, #64748b, #475569);
        border: none;
    }

    .btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(0,0,0,0.4);
    }

    .video-table {
        background: rgba(255,255,255,0.04);
        border-radius: 15px;
        overflow: hidden;
        backdrop-filter: blur(10px);
        box-shadow: 0 8px 30px rgba(0,0,0,0.6);
    }

        .video-table th {
            background: rgba(255,255,255,0.08);
            font-weight: 500;
            text-transform: uppercase;
            font-size: 13px;
            letter-spacing: 1px;
        }

        .video-table td {
            vertical-align: middle;
        }

    .video-preview video {
        border-radius: 10px;
        transition: 0.3s ease;
    }

        .video-preview video:hover {
            transform: scale(1.08);
            box-shadow: 0 5px 20px rgba(0,0,0,0.5);
        }

    .action-buttons .btn {
        margin-bottom: 5px;
    }
</style>

<div class="admin-container">

    <div class="admin-header">
        <h3><i class="fa fa-video me-2"></i> Video Management</h3>
        <div>
            <a class="btn btn-success btn-custom me-2" href="/Videos/Create">
                <i class="fa fa-plus me-1"></i> Add Video
            </a>

            <a class="btn btn-secondary btn-custom me-2" href="/Admin/Categories">
                <i class="fa fa-list me-1"></i> Categories
            </a>

            <a class="btn btn-danger btn-custom" href="/Admin/Logout">
                <i class="fa fa-sign-out-alt me-1"></i> Logout
            </a>
        </div>
    </div>

    <div class="video-table">
        <table class="table table-dark table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Title</th>
                    <th>Category</th>
                    <th>Preview</th>
                    <th style="width:200px;">Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var v in Model)
                {
                    <tr>
                        <td>@v.Id</td>

                        <td>
                            <strong>@v.Title</strong>
                        </td>

                        <td>
                            <span class="badge bg-info text-dark">
                                @v.Category?.Name
                            </span>
                        </td>

                        <td class="video-preview">
                            <video width="150" height="90" controls>
                                <source src="~/@v.VideoPath" type="video/mp4" />
                            </video>
                        </td>

                        <td class="action-buttons">
                            <a class="btn btn-sm btn-primary btn-custom"
                               href="/Videos/Edit/@v.Id">
                                <i class="fa fa-edit"></i>
                            </a>

                            <form method="post"
                                  action="/Videos/Delete/@v.Id"
                                  style="display:inline;"
                                  onsubmit="return confirm('Are you sure you want to delete this video?');">
                                <button class="btn btn-sm btn-danger btn-custom">
                                    <i class="fa fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>
