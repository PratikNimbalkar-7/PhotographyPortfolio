@*
    _Layout.cshtml — Fixed Extra Slim Black Theme for Photography Portfolio
*@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Photography Portfolio</title>

    <!-- Bootstrap & Font Awesome -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />

    <style>
      


        /* ===== GLASS NAVBAR ===== */
        .glass-navbar {
            background: rgba(2, 6, 23, 0.75);
            backdrop-filter: blur(12px);
            box-shadow: 0 10px 30px rgba(0,0,0,.4);
            padding: 12px 0;
            transition: all .3s ease;
        }

        /* BRAND */
        .brand-icon {
            font-size: 1.4rem;
            color: #00bcd4;
        }

        .brand-text {
            letter-spacing: 1px;
        }

        /* NAV LINKS */
        .navbar-nav .nav-link {
            color: #cbd5f5 !important;
            padding: 8px 14px;
            border-radius: 10px;
            transition: all .3s ease;
        }

        /* HOVER EFFECT */
        .nav-animate:hover {
            background: rgba(0, 188, 212, 0.15);
            color: #00e5ff !important;
            transform: translateY(-2px);
        }

        /* ACTIVE */
        .navbar-nav .nav-link.active {
            background: rgba(0, 188, 212, 0.25);
            color: #00e5ff !important;
        }

        /* ADMIN BUTTON */
        .admin-btn {
            border-radius: 20px;
            padding: 6px 18px;
        }

        /* MOBILE FIX */
        @@media (max-width: 991px) {
            .navbar-nav {
                margin-top: 15px;
                background: rgba(2, 6, 23, 0.95);
                padding: 15px;
                border-radius: 14px;
            }
        }

        body {
            padding-top: 60px;
        }

        .glass-navbar {
            padding: 10px 0;
        }


    </style>
</head>
<body>

  


    <nav class="navbar navbar-expand-lg navbar-dark fixed-top glass-navbar">
        <div class="container">

            <!-- BRAND -->
            <a class="navbar-brand d-flex align-items-center fw-bold" href="/">
                <i class="fa fa-camera-retro me-2 brand-icon"></i>
                <span class="brand-text">Photography</span>
            </a>

            <!-- TOGGLER -->
            <button class="navbar-toggler border-0 shadow-none" type="button"
                    data-bs-toggle="collapse" data-bs-target="#navbarContent">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- MENU -->
            <div class="collapse navbar-collapse" id="navbarContent">
                <ul class="navbar-nav ms-auto gap-lg-2">

                    <li class="nav-item">
                        <a class="nav-link nav-animate @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                           href="/">
                            <i class="fa fa-home me-1"></i> Home
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link nav-animate @(ViewContext.RouteData.Values["action"]?.ToString() == "About" ? "active" : "")"
                           href="/Home/About">
                            <i class="fa fa-user me-1"></i> About
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link nav-animate @(ViewContext.RouteData.Values["action"]?.ToString() == "Contact" ? "active" : "")"
                           href="/Home/Contact">
                            <i class="fa fa-envelope me-1"></i> Contact
                        </a>
                    </li>

                    <!-- ADMIN BUTTON -->
                    <li class="nav-item ms-lg-3">
                        <a class="btn btn-outline-info btn-sm admin-btn"
                           href="/Admin/Login">
                            <i class="fa fa-user-shield me-1"></i> Admin
                        </a>
                    </li>

                </ul>
            </div>

        </div>
    </nav>

    <!-- Page Body -->
    <main class="container">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="text-center">
        <div class="container">
            <p class="mb-2">
                &copy; @DateTime.Now.Year <span style="color:#00bcd4;" class="fw-semibold">Photography Portfolio</span>. All rights reserved.
            </p>
            <div>
                <a href="https://instagram.com" target="_blank" class="me-3"><i class="fab fa-instagram fa-lg"></i></a>
                <a href="https://facebook.com" target="_blank" class="me-3"><i class="fab fa-facebook fa-lg"></i></a>
                <a href="https://twitter.com" target="_blank" class="me-3"><i class="fab fa-twitter fa-lg"></i></a>
                <a href="https://youtube.com" target="_blank"><i class="fab fa-youtube fa-lg"></i></a>
            </div>
        </div>
    </footer>


    @if (TempData["SuccessMessage"] != null)
    {
        <div class="modal fade" id="successModal" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">

                    <div class="modal-header bg-success text-white">
                        <h5 class="modal-title">photo uploaded successfully</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body text-center">
                        <i class="fa fa-check-circle text-success fs-1 mb-2"></i>

                        <p class="fs-5 mb-3">
                            @TempData["SuccessMessage"]
                        </p>

                        <!-- ✅ OK BUTTON -->
                        <button type="button"
                                class="btn btn-success px-4"
                                data-bs-dismiss="modal">
                            OK
                        </button>
                    </div>

                </div>
            </div>
        </div>
    }



    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>


    <!-- ✅ AUTO SHOW POPUP -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var modalElement = document.getElementById("successModal");
            if (modalElement) {
                var modal = new bootstrap.Modal(modalElement);
                modal.show();
            }
        });
    </script>

    @RenderSection("Scripts", required: false)


    

</body>
</html>
