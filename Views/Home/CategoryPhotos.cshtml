@model IEnumerable<PhotographyPortfolio.Models.Photo>

@{
    ViewData["Title"] = ViewBag.CategoryName;
}

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">

<style>
    :root {
        --bg-main: #020617;
        --bg-card: rgba(2,6,23,.75);
        --accent: #38bdf8;
        --text-main: #e5e7eb;
        --text-muted: #94a3b8;
    }

    body {
        background: radial-gradient(circle at top, #020617, #000);
        color: var(--text-main);
        font-family: 'Poppins', sans-serif;
    }

    /* ================= HEADER ================= */
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 50px;
    }

        .page-header h2 {
            color: var(--accent);
            font-weight: 600;
        }

    .btn-back {
        background: linear-gradient(135deg, #38bdf8, #2563eb);
        color: #000;
        padding: 8px 22px;
        border-radius: 999px;
        text-decoration: none;
        font-size: .85rem;
        transition: .3s;
    }

        .btn-back:hover {
            transform: scale(1.06);
        }

    /* ================= PHOTO CARD ================= */
    .photo-card {
        background: var(--bg-card);
        backdrop-filter: blur(16px);
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 30px 80px rgba(0,0,0,.7);
        transition: all .45s ease;
    }

        .photo-card:hover {
            transform: translateY(-12px);
        }

        .photo-card img {
            width: 100%;
            height: 260px;
            object-fit: cover;
            cursor: pointer;
            transition: transform .6s ease;
        }

        .photo-card:hover img {
            transform: scale(1.08);
        }

    .photo-title {
        padding: 14px;
        text-align: center;
        color: var(--text-muted);
        font-size: .9rem;
    }

    /* ================= MODAL ================= */
    .modal-content {
        background: rgba(0,0,0,.95);
        border: none;
        border-radius: 22px;
        backdrop-filter: blur(16px);
    }

    .modal-body {
        padding: 20px 20px 70px;
        text-align: center;
        position: relative;
    }

        .modal-body img {
            max-height: 80vh;
            max-width: 100%;
            border-radius: 18px;
            box-shadow: 0 40px 100px rgba(0,0,0,.9);
        }

    /* ================= CLOSE ================= */
    .btn-close-modal {
        position: absolute;
        top: 18px;
        right: 18px;
        width: 38px;
        height: 38px;
        border-radius: 50%;
        border: none;
        background: #ef4444;
        color: #fff;
        font-size: 1.2rem;
        cursor: pointer;
        z-index: 10;
    }

    /* ================= UNIQUE NAV BAR ================= */
    .modal-nav {
        position: absolute;
        bottom: 18px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 16px;
        background: rgba(255,255,255,.08);
        backdrop-filter: blur(14px);
        padding: 10px 18px;
        border-radius: 999px;
        box-shadow: 0 15px 40px rgba(0,0,0,.6);
    }

        .modal-nav button {
            border: none;
            background: transparent;
            color: var(--accent);
            font-size: .85rem;
            font-weight: 500;
            padding: 6px 16px;
            border-radius: 999px;
            transition: .3s ease;
        }

            .modal-nav button:hover {
                background: var(--accent);
                color: #000;
            }

    /* ================= TITLE ================= */
    #modalTitle {
        color: var(--accent);
        margin-top: 15px;
        font-weight: 500;
    }

    /* ================= ANIMATION ================= */
    .photo-card {
        opacity: 0;
        transform: translateY(40px);
    }
</style>

<div class="container py-5">
    <div class="page-header">
        <h2>@ViewBag.CategoryName</h2>
        <a href="@Url.Action("Index", "Home")" class="btn-back">← Back</a>
    </div>

    <div class="row">
        @foreach (var p in Model)
        {
            <div class="col-sm-6 col-md-4 col-lg-3 mb-4">
                <div class="photo-card">
                    <img src="@p.ImagePath"
                         class="gallery-img"
                         data-title="@p.Title" />
                    <div class="photo-title">@p.Title</div>
                </div>
            </div>
        }
    </div>
</div>

<!-- ================= MODAL ================= -->
<div class="modal fade" id="photoModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
            <div class="modal-body">
                <button class="btn-close-modal" data-bs-dismiss="modal">×</button>
                <img id="modalImage" />

                <!-- UNIQUE BUTTON BAR -->
                <div class="modal-nav">
                    <button id="prevBtn">◀ Previous</button>
                    <button id="nextBtn">Next ▶</button>
                </div>
            </div>
            <div class="text-center pb-3">
                <h6 id="modalTitle"></h6>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const images = document.querySelectorAll(".gallery-img");
        const modal = new bootstrap.Modal(document.getElementById("photoModal"));
        const modalImage = document.getElementById("modalImage");
        const modalTitle = document.getElementById("modalTitle");
        let currentIndex = 0;

        images.forEach((img, index) => {
            img.addEventListener("click", () => {
                currentIndex = index;
                showImage();
                modal.show();
            });
        });

        function showImage() {
            modalImage.src = images[currentIndex].src;
            modalTitle.textContent = images[currentIndex].dataset.title;
        }

        document.getElementById("prevBtn").onclick = () => {
            currentIndex = (currentIndex - 1 + images.length) % images.length;
            showImage();
        };

        document.getElementById("nextBtn").onclick = () => {
            currentIndex = (currentIndex + 1) % images.length;
            showImage();
        };

        // Keyboard support
        document.addEventListener("keydown", e => {
            if (!document.getElementById("photoModal").classList.contains("show")) return;
            if (e.key === "ArrowRight") document.getElementById("nextBtn").click();
            if (e.key === "ArrowLeft") document.getElementById("prevBtn").click();
        });

        // Scroll reveal
        const observer = new IntersectionObserver(entries => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.opacity = 1;
                    entry.target.style.transform = "translateY(0)";
                }
            });
        }, { threshold: 0.15 });

        document.querySelectorAll(".photo-card").forEach(card => observer.observe(card));
    </script>
}
