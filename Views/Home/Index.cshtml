@model IEnumerable<PhotographyPortfolio.ViewModels.CategoryMediaViewModel>

@{
    ViewData["Title"] = "Photo Gallery";
}

<style>
    body {
        background: radial-gradient(circle at top, #121212, #000);
        color: #f1f5f9;
        font-family: 'Poppins', sans-serif;
    }

    h1 {
        color: #38bdf8;
        text-align: center;
        margin-bottom: 60px;
        font-weight: 700;
        letter-spacing: 1.5px;
    }

    .category-name {
        color: #38bdf8;
        font-size: 1.4rem;
        letter-spacing: 1px;
        margin-bottom: 25px;
    }

    .section-label {
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 2px;
        color: #94a3b8;
        margin-bottom: 15px;
    }

    .card {
        background: linear-gradient(145deg, #0f172a, #020617);
        border-radius: 16px;
        overflow: hidden;
        transition: transform 0.4s ease, box-shadow 0.4s ease;
        cursor: pointer;
    }

        .card:hover {
            transform: translateY(-6px);
            box-shadow: 0 25px 60px rgba(56, 189, 248, 0.15);
        }

    /* Photos */
    .photo-card img {
        width: 100%;
        height: 220px;
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    .photo-card:hover img {
        transform: scale(1.08);
    }

    /* Videos */
    .video-card video {
        width: 100%;
        border-radius: 14px;
        background: #000;
    }

    .media-title {
        font-size: 0.95rem;
        margin-top: 8px;
        font-weight: 600;
    }

    .media-sub {
        font-size: 0.8rem;
        color: #94a3b8;
    }

    .category-divider {
        height: 1px;
        background: linear-gradient(to right, transparent, #38bdf8, transparent);
        margin: 60px 0;
    }

    /* LIGHTBOX */
    .lightbox {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.95);
        display: none;
        justify-content: center;
        align-items: center;
        z-index: 9999;
    }

        .lightbox img {
            max-width: 90%;
            max-height: 90%;
            border-radius: 16px;
            box-shadow: 0 0 60px rgba(56,189,248,0.4);
            animation: zoomIn 0.3s ease;
        }

    @@keyframes zoomIn {
        from {
            transform: scale(0.85);
            opacity: 0;
        }

        to {
            transform: scale(1);
            opacity: 1;
        }
    }
</style>

<div class="container gallery-section">
    <h1>📸 Photo Gallery</h1>

    @if (Model != null && Model.Any())
    {
        @foreach (var group in Model)
        {
            <div class="col-12">

                <h3 class="category-name text-center">
                    @group.Category.Name
                </h3>

                <!-- PHOTOS -->
                @if (group.Photos?.Any() == true)
                {
                    <p class="section-label text-center">Photography</p>

                    <div class="row mb-4">
                        @foreach (var photo in group.Photos)
                        {
                            <div class="col-sm-6 col-md-4 col-lg-3 mb-4">
                                <div class="card photo-card">
                                    <img src="@photo.ImagePath"
                                         alt="@group.Category.Name"
                                         onclick="openLightbox('@photo.ImagePath')" />
                                </div>
                            </div>
                        }
                    </div>
                }

                <!-- VIDEOS -->
                @if (group.videos?.Any() == true)
                {
                    <p class="section-label text-center">Cinematic Films</p>

                    <div class="row">
                        @foreach (var video in group.videos)
                        {
                            <div class="col-md-6 col-lg-4 mb-4">
                                <div class="card video-card p-3">
                                    <video controls preload="metadata">
                                        <source src="/@video.VideoPath" type="video/mp4" />
                                    </video>

                                    <div class="mt-2 text-center">
                                        <div class="media-title">@video.Title</div>
                                        <div class="media-sub">@video.Description</div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }

                <div class="category-divider"></div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-warning text-center mt-4">
            No categories or photos found.
        </div>
    }
</div>

<!-- LIGHTBOX -->
<div id="lightbox" class="lightbox" onclick="closeLightbox()">
    <img id="lightbox-img" />
</div>

<script>
    // PHOTO LIGHTBOX
    function openLightbox(src) {
        document.getElementById("lightbox-img").src = src;
        document.getElementById("lightbox").style.display = "flex";
    }

    function closeLightbox() {
        document.getElementById("lightbox").style.display = "none";
    }

    // VIDEO HOVER PLAY
    document.querySelectorAll("video").forEach(v => {
        v.muted = true;
        v.addEventListener("mouseenter", () => v.play());
        v.addEventListener("mouseleave", () => {
            v.pause();
            v.currentTime = 0;
        });
    });
</script>
