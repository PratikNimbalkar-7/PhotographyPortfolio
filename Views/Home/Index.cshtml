@model IEnumerable<PhotographyPortfolio.ViewModels.CategoryMediaViewModel>

@{
    ViewData["Title"] = "Photo Gallery";
}

<!-- Google Font -->
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">

<style>

    :root {
        --bg-main: #020617;
        --bg-card: rgba(2, 6, 23, 0.85);
        --accent: #38bdf8;
        --text-main: #e5e7eb;
        --text-muted: #94a3b8;
    }

    /* ================= BASE ================= */

    body {
        background: radial-gradient(circle at top, #020617, #000);
        color: var(--text-main);
        font-family: 'Poppins', sans-serif;
    }

    .container {
        max-width: 1200px;
    }

    /* ================= HERO VIDEO ================= */

    .hero-wrapper {
        display: flex;
        justify-content: center;
        margin: 70px 0 100px;
    }

    .hero-box {
        width: 100%;
        max-width: 1100px;
        height: 420px;
        border-radius: 28px;
        overflow: hidden;
        position: relative;
        box-shadow: 0 60px 120px rgba(0,0,0,.9);
    }

        .hero-box video {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(0,0,0,.85), transparent);
        display: flex;
        align-items: flex-end;
        padding: 35px;
    }

        .hero-overlay h2 {
            font-size: 2.2rem;
            font-weight: 600;
        }

        .hero-overlay p {
            color: var(--text-muted);
        }

    /* ================= CARD ================= */

    .gallery-card {
        background: var(--bg-card);
        border-radius: 28px;
        padding: 45px;
        margin-bottom: 70px;
        border: 1px solid rgba(255,255,255,.08);
        box-shadow: 0 45px 110px rgba(0,0,0,.7);
        transition: .4s ease;
    }

        .gallery-card:hover {
            transform: translateY(-10px);
        }

    /* ================= TITLE ================= */

    .category-title {
        color: var(--accent);
        letter-spacing: 2px;
        font-weight: 600;
        text-transform: uppercase;
    }

    .category-quote {
        max-width: 700px;
        margin: 15px auto 40px;
        font-style: italic;
        color: var(--text-muted);
    }

    /* ================= MEDIA ================= */

    .media-preview {
        width: 100%;
        height: 260px;
        object-fit: cover;
        border-radius: 22px;
        cursor: pointer;
        box-shadow: 0 25px 70px rgba(0,0,0,.7);
        transition: .5s ease;
    }

        .media-preview:hover {
            transform: scale(1.05);
        }

    /* ================= BUTTON ================= */

    .btn-custom {
        border-radius: 999px;
        padding: 8px 24px;
        font-size: .85rem;
    }

    /* ================= LIGHTBOX ================= */

    .lightbox {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.95);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 9999;
    }

        .lightbox img {
            max-width: 90%;
            max-height: 90%;
            border-radius: 20px;
        }

    .lightbox-close {
        position: absolute;
        top: 25px;
        right: 35px;
        font-size: 42px;
        cursor: pointer;
    }

    /* ================= MOBILE ================= */

    @@media(max - width:768px) {

        .hero-box {
            height: 230px;
        }

        .gallery-card {
            padding: 25px;
        }
    }

</style>

<!-- ================= HERO ================= -->
@if (ViewBag.LastVideo != null)
{
    <div class="hero-wrapper">
        <div class="hero-box">

            <video autoplay muted loop playsinline>
                <source src="/@ViewBag.LastVideo.VideoPath" type="video/mp4" />
            </video>

            <div class="hero-overlay">
                <div>
                    <h2>Latest Cinematic Work</h2>
                    <p>Crafting moments into timeless stories</p>
                </div>
            </div>

        </div>
    </div>
}

<!-- ================= GALLERY ================= -->

<div class="container pb-5">

    @if (Model != null && Model.Any())
    {
        foreach (var group in Model)
        {
            <div class="gallery-card reveal">

                <div class="text-center mb-4">

                    <h3 class="category-title category-name">
                        @group.Category.Name
                    </h3>

                    <p class="category-quote"></p>

                </div>

                <div class="row align-items-center text-center">

                    <!-- Photo -->
                    <div class="col-md-4 mb-4">

                        @if (group.Photos.Any())
                        {
                            var photo = group.Photos.First();

                            <img src="@photo.ImagePath"
                                 class="media-preview"
                                 onclick="openLightbox('@photo.ImagePath')" />

                            <div class="mt-3">

                                <a class="btn btn-outline-info btn-custom"
                                   href="@Url.Action("CategoryPhotos","Home",
                                                                       new { id = group.Category.Id })">

                        View Photos

                                </a>

                            </div>
                                }

                    </div>

                    <!-- Video -->
                    <div class="col-md-4 mb-4">

                        @if (group.videos.Any())
                        {
                            var video = group.videos.First();

                            <video class="media-preview"
                                   muted preload="metadata"
                                   onmouseenter="this.play()"
                                   onmouseleave="this.pause();this.currentTime=0;">

                                <source src="/@video.VideoPath" type="video/mp4" />

                            </video>

                            <div class="mt-3">

                                <a class="btn btn-outline-warning btn-custom"
                                   href="@Url.Action("CategoryVideos","Home",
                                                                       new { id = group.Category.Id })">

                        View Videos

                                </a>

                            </div>
                                }

                    </div>

                    <!-- Description -->
                    <div class="col-md-4">

                        <p class="text-muted small">

                            Discover the complete
                            <strong>@group.Category.Name</strong>
                            visual story

                        </p>

                    </div>

                </div>

            </div>
        }
    }

</div>

<!-- ================= LIGHTBOX ================= -->

<div id="lightbox" class="lightbox">

    <span class="lightbox-close" onclick="closeLightbox()">×</span>

    <img id="lightbox-img" />

</div>

<!-- ================= SCRIPT ================= -->

<script>

    /* ============ LIGHTBOX ============ */

    function openLightbox(src) {

        const box = document.getElementById("lightbox");

        document.getElementById("lightbox-img").src = src;

        box.style.display = "flex";
        document.body.style.overflow = "hidden";
    }

    function closeLightbox() {

        document.getElementById("lightbox").style.display = "none";

        document.body.style.overflow = "auto";
    }

    /* ============ QUOTES ============ */

    const quotes = {

        "Candid": "Candid moments are the truest stories.",
        "Wedding": "Every wedding tells a love story.",
        "Pre Wedding": "Before forever begins.",
        "Birthday": "Smiles, surprises, memories.",
        "Baby Shoot": "Tiny moments, big love.",
        "Engagement": "The beginning of forever."

    };

    document.querySelectorAll(".gallery-card").forEach(card => {

        const name = card.querySelector(".category-name").innerText.trim();

        card.querySelector(".category-quote").innerText =
            quotes[name] || "Moments fade, memories stay forever.";

    });


    /* ============ SCROLL ANIMATION ============ */

    const observer = new IntersectionObserver(entries => {

        entries.forEach(entry => {

            if (entry.isIntersecting) {

                entry.target.style.opacity = 1;
                entry.target.style.transform = "translateY(0)";
            }

        });

    }, { threshold: 0.2 });


    document.querySelectorAll(".reveal").forEach(el => {

        el.style.opacity = 0;
        el.style.transform = "translateY(50px)";
        el.style.transition = "all .7s ease";

        observer.observe(el);

    });

</script>
