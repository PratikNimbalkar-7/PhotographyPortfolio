@model IEnumerable<PhotographyPortfolio.ViewModels.CategoryMediaViewModel>

@{
    ViewData["Title"] = "Photo Gallery";
}



<style>
    body {
        background: #0f172a;
        color: #f1f5f9;
    }

    .gallery-card {
        background: #020617;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 20px 40px rgba(0,0,0,.4);
        transition: transform .3s, box-shadow .3s;
    }

        .gallery-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 30px 60px rgba(56,189,248,.15);
        }

    .preview-img,
    .preview-video {
        height: 280px;
        object-fit: cover;
        border-radius: 14px;
        width: 100%;
        cursor: pointer;
    }

    .category-title {
        color: #38bdf8;
        letter-spacing: 1px;
    }

    /* HEADER VIDEO */
    .header-video-wrapper {
        display: flex;
        justify-content: center;
        margin-top: 30px;
    }

    .header-video-box {
        width: 100%;
        max-width: 1000px;
        height: 350px;
        border-radius: 20px;
        overflow: hidden;
        position: relative;
        background: #020617;
        box-shadow: 0 25px 50px rgba(0,0,0,.6);
    }

        .header-video-box video {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .video-overlay {
        position: absolute;
        bottom: 0;
        width: 100%;
        padding: 18px;
        background: linear-gradient(to top, rgba(0,0,0,.75), transparent);
        color: #fff;
    }

    @@media (max-width: 768px) {
        .header-video-box {
            max-width: 100%;
            height: 220px;
            border-radius: 14px;
        }
    }

    /* .header-video-box {
        max-width: 1100px;
        aspect-ratio: 16 / 9;
        height: auto;
    } */

    .header-video-box video {
        pointer-events: none;
    }

</style>

<!-- ================= SCRIPTS ================= -->

<script>
    function openLightbox(src) {
        document.getElementById("lightbox-img").src = src;
        document.getElementById("lightbox").classList.remove("d-none");
    }

    function closeLightbox() {
        document.getElementById("lightbox").classList.add("d-none");
    }

    // 🎥 GALLERY VIDEO HOVER PLAY
    document.querySelectorAll(".preview-video").forEach(video => {
        video.muted = true;

        video.addEventListener("mouseenter", () => {
            video.play();
        });

        video.addEventListener("mouseleave", () => {
            video.pause();
            video.currentTime = 0;
        });
    });
</script>

<!-- ================= HEADER : LAST UPLOADED VIDEO ================= -->
@if (ViewBag.LastVideo != null)
{
    <div class="header-video-wrapper">
        <div class="header-video-box">
            <video autoplay
                   muted
                   loop
                   playsinline
                   preload="auto"
                   disablepictureinpicture
                   controlslist="nodownload noplaybackrate">
                <source src="/@ViewBag.LastVideo.VideoPath" type="video/mp4" />
            </video>
            <div class="video-overlay">
                <h4>Latest Upload</h4>
            </div>
        </div>
    </div>
}



<div class="container py-5">

    <h1 class="text-center fw-bold mb-5 category-title">
        📸 Photo Gallery
    </h1>

    @if (Model != null && Model.Any())
    {
        foreach (var group in Model)
        {
            <div class="row align-items-center mb-5 gallery-card">

                <!-- CATEGORY -->
                <div class="col-12 text-center mb-4">
                    <h3 class="fw-bold category-title">
                        @group.Category.Name
                    </h3>
                </div>

                <!-- PHOTO -->
                <div class="col-md-4 text-center">
                    @if (group.Photos.Any())
                    {
                        var photo = group.Photos.First();

                        <img src="@photo.ImagePath"
                             class="preview-img mb-3"
                             alt="@photo.Title"
                             onclick="openLightbox('@photo.ImagePath')" />

                        <a href="@Url.Action("CategoryPhotos", "Home", new { id = group.Category.Id })"
                           class="btn btn-outline-info btn-sm">
                            View All Photos
                        </a>
                    }
                    else
                    {
                        <span class="text-muted">No photos</span>
                    }
                </div>

                <!-- VIDEO -->
                <div class="col-md-4 text-center">
                    @if (group.videos.Any())
                    {
                        var video = group.videos.First();

                        <video class="preview-video mb-3"
                               muted
                               preload="metadata"
                               onmouseenter="this.play()"
                               onmouseleave="this.pause();this.currentTime=0;">
                            <source src="/@video.VideoPath" type="video/mp4" />
                        </video>

                        <a href="@Url.Action("CategoryVideos", "Home", new { id = group.Category.Id })"
                           class="btn btn-outline-warning btn-sm">
                            View All Videos
                        </a>
                    }
                    else
                    {
                        <span class="text-muted">No videos</span>
                    }
                </div>

                <!-- DESCRIPTION -->
                <div class="col-md-4 text-center">
                    <p class="text-muted small">
                        Explore full <strong>@group.Category.Name</strong> gallery
                    </p>
                </div>

            </div>
        }
    }
    else
    {
        <div class="alert alert-warning text-center">
            No categories found
        </div>
    }

</div>


<div id="lightbox" class="lightbox d-none">
    <span class="close-btn" onclick="closeLightbox()">×</span>
    <img id="lightbox-img" />
</div>


<script>
    function openLightbox(src) {
        document.getElementById("lightbox-img").src = src;
        document.getElementById("lightbox").classList.remove("d-none");
        document.getElementById("lightbox").classList.add("d-flex");
    }

    function closeLightbox() {
        document.getElementById("lightbox").classList.add("d-none");
        document.getElementById("lightbox").classList.remove("d-flex");
    }

      // VIDEO HOVER PLAY
    document.querySelectorAll("video").forEach(v => {
        v.muted = true;
        v.addEventListener("mouseenter", () => v.play());
        v.addEventListener("mouseleave", () => v.play());

    });

</script>
