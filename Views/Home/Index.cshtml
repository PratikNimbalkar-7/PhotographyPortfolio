@model IEnumerable<PhotographyPortfolio.ViewModels.CategoryMediaViewModel>

@{
    ViewData["Title"] = "Photo Gallery";
}

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">

<style>
    :root {
        --bg-main: #020617;
        --bg-card: rgba(2, 6, 23, 0.75);
        --accent: #38bdf8;
        --text-main: #e5e7eb;
        --text-muted: #94a3b8;
    }

    body {
        background: radial-gradient(circle at top, #020617, #000);
        color: var(--text-main);
        font-family: 'Poppins', sans-serif;
    }

    /* ================= HERO VIDEO ================= */
    .header-video-wrapper {
        display: flex;
        justify-content: center;
        margin: 60px 0 90px;
    }

    .header-video-box {
        max-width: 1100px;
        width: 100%;
        height: 420px;
        border-radius: 28px;
        overflow: hidden;
        box-shadow: 0 50px 120px rgba(0,0,0,.85);
        position: relative;
    }

        .header-video-box video {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .video-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(0,0,0,.85), transparent);
        display: flex;
        align-items: flex-end;
        padding: 35px;
    }

        .video-overlay h2 {
            font-size: 2rem;
            font-weight: 600;
        }

    /* ================= GALLERY CARD ================= */
    .gallery-card {
        background: var(--bg-card);
        backdrop-filter: blur(18px);
        border-radius: 28px;
        padding: 40px;
        margin-bottom: 60px;
        box-shadow: 0 40px 100px rgba(0,0,0,.6);
        border: 1px solid rgba(255,255,255,.06);
        transition: .45s ease;
    }

        .gallery-card:hover {
            transform: translateY(-12px);
        }

    /* ================= CATEGORY ================= */
    .category-title {
        color: var(--accent);
        font-weight: 600;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    /* ================= QUOTE ================= */
    .category-quote {
        max-width: 700px;
        margin: 10px auto 35px;
        font-size: 1rem;
        font-style: italic;
        color: var(--text-muted);
        line-height: 1.6;
    }

    /* ================= MEDIA ================= */
    .preview-img,
    .preview-video {
        height: 280px;
        width: 100%;
        object-fit: cover;
        border-radius: 22px;
        cursor: pointer;
        box-shadow: 0 25px 70px rgba(0,0,0,.7);
        transition: .6s ease;
    }

        .preview-img:hover,
        .preview-video:hover {
            transform: scale(1.06);
        }

    /* ================= BUTTON ================= */
    .btn {
        border-radius: 999px;
        padding: 8px 22px;
        font-size: .8rem;
    }

    /* ================= LIGHTBOX ================= */
    .lightbox {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.92);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
    }

        .lightbox img {
            max-width: 90%;
            max-height: 90%;
            border-radius: 20px;
        }

    .close-btn {
        position: absolute;
        top: 30px;
        right: 40px;
        font-size: 42px;
        cursor: pointer;
    }

    /* ================= MOBILE ================= */
    @@media (max-width: 768px) {
        .header-video-box {
            height: 240px;
        }
    }
</style>

<!-- ================= HEADER VIDEO ================= -->
@if (ViewBag.LastVideo != null)
{
    <div class="header-video-wrapper">
        <div class="header-video-box">
            <video autoplay muted loop playsinline>
                <source src="/@ViewBag.LastVideo.VideoPath" type="video/mp4" />
            </video>
            <div class="video-overlay">
                <div>
                    <h2>Latest Cinematic Work</h2>
                    <p class="text-muted">Crafting moments into timeless stories</p>
                </div>
            </div>
        </div
    </div
}

<!-- ================= GALLERY ================= -->
<div class="container pb-5">
    @if (Model != null && Model.Any())
    {
        foreach (var group in Model)
        {
            <div class="gallery-card">

                <div class="text-center mb-4">
                    <h3 class="category-title category-name">@group.Category.Name</h3>
                    <p class="category-quote"></p>
                </div>

                <div class="row align-items-center">
                    <div class="col-md-4 text-center mb-3">
                        @if (group.Photos.Any())
                        {
                            var photo = group.Photos.First();
                            <img src="@photo.ImagePath" class="preview-img"
                                 onclick="openLightbox('@photo.ImagePath')" />

                            <a class="btn btn-outline-info mt-3"
                               href="@Url.Action("CategoryPhotos", "Home", new { id = group.Category.Id })">
                                View Photos
                            </a>
                        }
                    </div>

                    <div class="col-md-4 text-center mb-3">
                        @if (group.videos.Any())
                        {
                            var video = group.videos.First();
                            <video class="preview-video" muted preload="metadata"
                                   onmouseenter="this.play()"
                                   onmouseleave="this.pause();this.currentTime=0;">
                                <source src="/@video.VideoPath" type="video/mp4" />
                            </video>

                            <a class="btn btn-outline-warning mt-3"
                               href="@Url.Action("CategoryVideos", "Home", new { id = group.Category.Id })">
                                View Videos
                            </a>
                        }
                    </div>

                    <div class="col-md-4 text-center">
                        <p class="text-muted small">
                            Discover the complete <strong>@group.Category.Name</strong> visual story
                        </p>
                    </div>
                </div>
            </div>
        }
    }
</div>

<!-- ================= LIGHTBOX ================= -->
<div id="lightbox" class="lightbox d-none">
    <span class="close-btn" onclick="closeLightbox()">×</span>
    <img id="lightbox-img" />
</div>

<!-- ================= SCRIPTS ================= -->
<script>
    function openLightbox(src) {
        document.getElementById("lightbox-img").src = src;
        document.getElementById("lightbox").classList.remove("d-none");
    }
    function closeLightbox() {
        document.getElementById("lightbox").classList.add("d-none");
    }

    /* ================= CATEGORY QUOTES ================= */
    const quotes = {
        "Candid": "Candid moments are the truest stories — unscripted, unfiltered, unforgettable.",
        "Wedding": "Every wedding tells a love story, and every frame keeps it alive forever.",
        "Pre Wedding": "Before the vows, before forever — just love, laughter, and promises.",
        "Birthday": "A celebration of smiles, surprises, and memories worth reliving.",
        "Baby Shoot": "Tiny moments, big love — memories that grow with time.",
        "Engagement": "The beginning of forever, captured one emotion at a time."
    };

    document.querySelectorAll(".gallery-card").forEach(card => {
        const name = card.querySelector(".category-name").innerText.trim();
        const quoteBox = card.querySelector(".category-quote");
        quoteBox.innerText = quotes[name] || "Moments fade, memories stay forever.";
    });

    /* ================= SCROLL REVEAL ================= */
    const observer = new IntersectionObserver(entries => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.style.opacity = 1;
                entry.target.style.transform = "translateY(0)";
            }
        });
    },{ threshold: 0.15 });

    document.querySelectorAll(".gallery-card").forEach(card => {
        card.style.opacity = 0;
        card.style.transform = "translateY(40px)";
        observer.observe(card);
    });
</script>
