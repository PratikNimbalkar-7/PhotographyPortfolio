@model IEnumerable<PhotographyPortfolio.Models.Video>

<h2 class="text-center mb-4">
    🎬 @ViewBag.CategoryName - Videos
</h2>
<style>
    body {
        background-color: #0d0d0d;
        color: #f5f5f5;
        font-family: 'Poppins', sans-serif;
    }

    h2 {
        color: #00bcd4;
    }

    .card {
        background-color: #1a1a1a;
        border: 1px solid #333;
        transition: all 0.3s ease;
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 0 20px rgba(0, 188, 212, 0.4);
        }

        .card img {
            border-bottom: 1px solid #333;
            transition: transform 0.3s ease;
            height: 220px;
            object-fit: cover;
            width: 100%;
            cursor: pointer;
        }

            .card img:hover {
                transform: scale(1.05);
            }

    .btn-back {
        background: linear-gradient(45deg, #00bcd4, #007bff);
        color: white;
        border: none;
        padding: 8px 18px;
        border-radius: 50px;
        text-decoration: none;
        display: inline-block;
        margin-bottom: 25px;
        transition: all 0.3s ease;
    }

        .btn-back:hover {
            transform: scale(1.05);
        }

    /* Lightbox Modal */
    .modal-content {
        background-color: #000;
        border: none;
        text-align: center;
        position: relative;
    }

    .modal-body {
        position: relative;
        padding: 0;
    }

        .modal-body img {
            max-height: 85vh;
            width: auto;
            border-radius: 10px;
        }

    /* Navigation Arrows */
    .nav-btn {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(0, 0, 0, 0.6);
        border: none;
        color: #00bcd4;
        font-size: 2.5rem;
        cursor: pointer;
        padding: 8px 15px;
        border-radius: 50%;
        transition: all 0.3s ease;
    }

        .nav-btn:hover {
            color: #fff;
            background: rgba(0, 188, 212, 0.6);
            transform: translateY(-50%) scale(1.1);
        }

    #prevBtn {
        left: 5px;
    }

    #nextBtn {
        right: 5px;
    }

    /* Title styling inside modal */
    #modalTitle {
        color: #00bcd4;
        margin-top: 15px;
    }

    .btn-close-modal {
        position: absolute;
        top: 15px;
        right: 15px;
        background: #dc3545;
        color: white;
        border: none;
        border-radius: 50%;
        width: 35px;
        height: 35px;
        font-size: 1.2rem;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
    }

        .btn-close-modal:hover {
            background: #ff4d4d;
            transform: scale(1.1);
        }
</style>

<<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">@ViewBag.CategoryName</h2>
        <a href="@Url.Action("Index", "Home")" class="btn-back">
            <i class="fa fa-arrow-left me-2"></i> Back to Gallery
        </a>
    </div>

    <div class="row" id="videoGallery">
        @foreach (var v in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card shadow-sm border-0 h-100 video-item"
                     data-src="/@v.VideoPath"
                     data-title="@v.Title">

                    <video class="card-img-top" preload="metadata">
                        <source src="/@v.VideoPath#t=0.5" type="video/mp4" />
                    </video>

                    <div class="card-body text-center">
                        <h5 class="fw-semibold">@v.Title</h5>
                        @if (!string.IsNullOrEmpty(v.Description))
                        {
                            <p class="text-muted small">@v.Description</p>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- 🎬 VIDEO MODAL -->
<div class="modal fade" id="videoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content bg-black">

            <div class="modal-body position-relative text-center">

                <!-- CLOSE -->
                <button type="button" class="btn-close-modal" data-bs-dismiss="modal">
                    <i class="fa fa-times"></i>
                </button>

                <!-- PREV -->
                <button id="prevVideoBtn" class="nav-btn">
                    <i class="fa fa-chevron-left"></i>
                </button>

                <!-- VIDEO -->
                <video id="modalVideo" controls autoplay class="w-100 rounded"></video>

                <!-- NEXT -->
                <button id="nextVideoBtn" class="nav-btn">
                    <i class="fa fa-chevron-right"></i>
                </button>

            </div>

            <div class="p-3 text-center text-white">
                <h5 id="modalVideoTitle"></h5>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        const videoCards = document.querySelectorAll(".video-item");
        const modal = new bootstrap.Modal(document.getElementById("videoModal"));
        const modalVideo = document.getElementById("modalVideo");
        const modalTitle = document.getElementById("modalVideoTitle");
        const prevBtn = document.getElementById("prevVideoBtn");
        const nextBtn = document.getElementById("nextVideoBtn");

        let currentIndex = 0;

        // Open modal
        videoCards.forEach((card, index) => {
            card.addEventListener("click", () => {
                currentIndex = index;
                showVideo();
                modal.show();
            });
        });

        function showVideo() {
            const card = videoCards[currentIndex];
            modalVideo.src = card.getAttribute("data-src");
            modalTitle.textContent = card.getAttribute("data-title");
            modalVideo.play();
        }

        prevBtn.addEventListener("click", () => {
            currentIndex = (currentIndex - 1 + videoCards.length) % videoCards.length;
            showVideo();
        });

        nextBtn.addEventListener("click", () => {
            currentIndex = (currentIndex + 1) % videoCards.length;
            showVideo();
        });

        // Stop video on close
        document.getElementById("videoModal").addEventListener("hidden.bs.modal", () => {
            modalVideo.pause();
            modalVideo.src = "";
        });

        // Keyboard navigation
        document.addEventListener("keydown", (e) => {
            if (!document.getElementById("videoModal").classList.contains("show")) return;
            if (e.key === "ArrowRight") nextBtn.click();
            if (e.key === "ArrowLeft") prevBtn.click();
            if (e.key === "Escape") modal.hide();
        });
    </script>
}